root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.{js,mjs,cjs,ts,vue,jsx,tsx,json,jsonc,yaml,yml,scss,css,html}]
indent_size = 2

[*.{json,jsonc}]
insert_final_newline = true

[*.sh]
indent_size = 2

[Makefile]
indent_style = tab

[{Dockerfile,Dockerfile.*,*.dockerfile}]
indent_size = 4

[*.conf]
indent_size = 4

[*.env,.env*]
indent_size = 2
insert_final_newline = true

[*.php]
indent_size = 4